export ARTIFACTORY_USER="$(pass ci/artifactory/user 2>/dev/null)"
export ARTIFACTORY_TOKEN="$(pass ci/artifactory/token 2>/dev/null)"
export GITHUB_TOKEN="$(pass ci/github/token 2>/dev/null)"
export SONARQUBE_TOKEN="$(pass ci/sonarqube/token 2>/dev/null)"
export SONARQUBE_URL="$(pass ci/sonarqube/url 2>/dev/null)"
export PUSHOVER_USERKEY="$(pass ci/pushover/userkey 2>/dev/null)"
export PUSHOVER_APPKEY="$(pass ci/pushover/appkey 2>/dev/null)"
export PUSHOVER_CLAUDE_APPKEY="$(pass ci/pushover/claude_appkey 2>/dev/null)"
export JIRA_USER="$(pass ci/jira/user 2>/dev/null)"
export JIRA_TOKEN="$(pass ci/jira/token 2>/dev/null)"
export JIRA_URL="$(pass ci/jira/url 2>/dev/null)"
export ANTHROPIC_API_KEY="$(pass ci/claude/jp-cicd-key 2>/dev/null)"
export CURSOR_API_KEY="$(pass ci/cursor/jp-cicd-key 2>/dev/null)"
gpgconf --reload all
